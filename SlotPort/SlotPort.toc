## Interface: 120100, 120105
## Title: SlotPort
## Notes: SlotPort lets you export and import your action bar layouts and macros between characters — as a compact, compressed string you can share or store anywhere.
## Author: Nightwalker559
## Version: 1.2.2
## X-Curse-Project-ID: 1535735
## IconTexture: Interface\AddOns\SlotPort\Media\icon
## SavedVariables: SlotPortDB
## OptionalDeps: ElvUI

# Libraries
Libs\LibStub\LibStub.lua
Libs\AceDB-3.0\AceDB-3.0.lua

# Localization (enUS must load first)
Locales\enUS.lua
Locales\deDE.lua

# Core (load order: SlotPort -> Bars -> ElvUI -> Selection -> Cache)
Core\SlotPort.lua
Core\Bars.lua
Core\ElvUI.lua
Core\Selection.lua
Core\Cache.lua

# Data (macros, export, import, character snapshots)
Data\Macros.lua
Data\Export.lua
Data\Import.lua
Data\Characters.lua

# UI (Widgets first: GUI and the page files use SlotPort.ui)
UI\Widgets.lua
UI\GUI.lua
UI\MacroPage.lua
UI\CharsPage.lua

# Optional diagnostics (not exposed via UI, run manually via /run when
# troubleshooting export/import issues)
Core\Debug.lua
